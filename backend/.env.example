# =====================================================================
# Переменные окружения бэкенда (Hugging Face Space)
# =====================================================================
# Бэкенд НЕ читает файлы .env. Эти значения вводятся на платформе:
#   Hugging Face Space -> Settings -> Variables and secrets
#     * обычные настройки  -> "New variable"
#     * ключи и пароли     -> "New secret"
# Для GitHub Actions секреты вводятся в: Settings -> Secrets and variables -> Actions
# Этот файл служит шпаргалкой. Значения в нём фиктивные.
# =====================================================================

# ---------- ОБЯЗАТЕЛЬНО (secrets) ----------
# Supabase -> Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase -> Settings -> API -> service_role (secret) key. Только в бэкенде и Actions, никогда во фронтенде!
SUPABASE_SERVICE_KEY=your-service-role-key
# https://twelvedata.com -> Dashboard -> API Keys (бесплатный план)
TWELVE_KEY=your-twelvedata-key

# ---------- ЖЕЛАТЕЛЬНО ----------
# https://finnhub.io -> бесплатный ключ. Экономический календарь на бесплатном плане может быть недоступен:
# тогда вносите события вручную в таблицу manual_events (Supabase -> Table Editor)
FINNHUB_KEY=

# Домен фронтенда на Vercel, БЕЗ слеша в конце. Несколько адресов через запятую.
ALLOWED_ORIGINS=https://mie.vercel.app,http://localhost:3000
# Preview-ссылки Vercel (регулярное выражение). Пустое значение отключает.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# ---------- ИНСТРУМЕНТЫ (необязательно) ----------
# Если пусто, берутся инструменты с default_on из data/instruments.py.
# Список символов через запятую переопределяет набор.
# Акции/FX/металлы/ETF (Twelve Data), например: EURUSD,GBPUSD,USDJPY,XAUUSD,SPY,QQQ
TD_SYMBOLS=
# Крипта (биржевые API без ключа), например: BTCUSDT,ETHUSDT,SOLUSDT
CRYPTO_SYMBOLS=
# Таймфреймы крипты
CRYPTO_TFS=M5,M15,H1

# ---------- БЮДЖЕТ TWELVE DATA ----------
# Бесплатный план: ~800 кредитов/сутки и 8 в минуту. Значения ниже оставляют запас.
TD_DAILY_LIMIT=700
TD_PER_MINUTE=8
# Часть суточного лимита, зарезервированная под ручные запросы с сайта
TD_RESERVE=40
# Сколько кредитов можно потратить сразу после полуночи UTC (дальше расход растёт равномерно)
TD_BURST=100
# Символы с «быстрым» ТФ и сами ТФ (остальные идут на медленном)
TD_FAST_SYMBOLS=EURUSD,XAUUSD,GBPUSD,USDJPY
TD_FAST_TF=M15
TD_SLOW_TF=H1

# ---------- ПОВЕДЕНИЕ ----------
# 0 = выключить внутренний планировщик (для отладки)
ENABLE_SCHEDULER=1
# Окно blackout вокруг новостей высокой важности (минут до / после)
BLACKOUT_BEFORE_MIN=20
BLACKOUT_AFTER_MIN=10
# Сколько дней хранить сигналы в Supabase
RETENTION_DAYS=45
# Имя приватного бакета в Supabase Storage
MODELS_BUCKET=models
# Порт. На Hugging Face не менять.
PORT=7860

# ---------- ОБУЧЕНИЕ (только GitHub Actions, workflow train-models) ----------
# Сколько баров брать для крипты на каждый символ
TRAIN_BARS_FAST=20000
TRAIN_BARS_SLOW=12000
# Максимум запросов к Twelve Data за один запуск обучения (каждый тратит 1 кредит из дневного лимита)
TRAIN_TD_MAX=30
# Какие группы обучать: crypto,fx,other
TRAIN_GROUPS=crypto,fx,other
