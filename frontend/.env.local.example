# Адрес бэкенда на Hugging Face Space (формат: https://ИМЯ-ПРОЕКТ.hf.space), без слеша в конце
NEXT_PUBLIC_API_URL=https://your-user-mie-backend.hf.space

# Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# НЕОБЯЗАТЕЛЬНО: запасной путь против CORS.
# Если NEXT_PUBLIC_API_URL оставить пустым, а задать BACKEND_URL, запросы пойдут через прокси Vercel.
BACKEND_URL=
